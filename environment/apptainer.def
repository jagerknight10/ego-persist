Bootstrap: docker
From: python:3.11.14-slim-bookworm

%help
    WISE-EgoMap runtime container.
    Build only from a clean checkout with a committed uv.lock file.

%files
    pyproject.toml /opt/wise-egomap/pyproject.toml
    uv.lock /opt/wise-egomap/uv.lock
    src /opt/wise-egomap/src
    configs /opt/wise-egomap/configs
    tests /opt/wise-egomap/tests
    environment/uv-version.txt /opt/wise-egomap/environment/uv-version.txt

%post
    #!/bin/bash
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive
    apt-get update
    apt-get install --yes --no-install-recommends ca-certificates git libgomp1
    rm -rf /var/lib/apt/lists/*
    cd /opt/wise-egomap
    uv_version="$(tr -d '[:space:]' < environment/uv-version.txt)"
    python -m pip install --no-cache-dir "uv==${uv_version}"
    uv sync --frozen --extra train --extra demo --extra aria --extra dev
    ./.venv/bin/python -c "import wise_egomap; import numpy; import yaml"
    umask 022
    chmod -R a+rX /opt/wise-egomap
    rm -rf /root/.cache/uv

%environment
    export PATH=/opt/wise-egomap/.venv/bin:/usr/local/bin:/usr/bin:/bin
    export PYTHONPATH=/opt/wise-egomap/src
    export PYTHONDONTWRITEBYTECODE=1

%runscript
    exec wise_egomap "$@"

%test
    #!/bin/bash
    set -euo pipefail
    cd /opt/wise-egomap
    python -m pytest tests -q
