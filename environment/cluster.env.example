# Source this file after you replace every placeholder.
# Keep the copied file outside Git. The project ignores .env.* files.

export WISE_EGOMAP_PROJECT_ROOT=/absolute/path/to/wise-egomap
export WISE_EGOMAP_DATA_ROOT=/absolute/path/to/read-only/adt
export WISE_EGOMAP_RUN_ROOT=/absolute/path/to/writable/runs
export WISE_EGOMAP_IMAGE=/absolute/path/to/wise-egomap.sif
export WISE_EGOMAP_SLURM_PARTITION=<GPU_PARTITION>
export WISE_EGOMAP_SLURM_ACCOUNT=<ACCOUNT>

export WISE_EGOMAP_DATA_CONFIG="${WISE_EGOMAP_PROJECT_ROOT}/configs/data/adt_v1.yaml"
export WISE_EGOMAP_LABEL_CONFIG="${WISE_EGOMAP_PROJECT_ROOT}/configs/labels_v1.yaml"
export WISE_EGOMAP_EXPERIMENT_CONFIG="${WISE_EGOMAP_PROJECT_ROOT}/configs/experiment/evidence_gru.yaml"
export WISE_EGOMAP_MODEL_CONFIG="${WISE_EGOMAP_PROJECT_ROOT}/configs/model/evidence_gru.yaml"
export WISE_EGOMAP_SPLIT_FILE="${WISE_EGOMAP_DATA_ROOT}/splits/adt_splits_v1.json"
# One experiment = one run id. All stages share it. Train array tasks
# add the suffix _train_seed_<SEED> automatically.
export WISE_EGOMAP_RUN_ID=exp001
export WISE_EGOMAP_SEED_BASE=0

# Set after a train stage completes: the run id of the trained model to
# evaluate (for example exp001_train_seed_0). Leave unset to evaluate the
# Bayes baseline.
# export WISE_EGOMAP_MODEL_RUN_ID=exp001_train_seed_0

# Set to yes only after the ADT licence is approved.
export WISE_EGOMAP_ADT_LICENCE_APPROVED=no

# Optional stage entry points. Change only when a package owner moves the CLI.
export WISE_EGOMAP_PREPROCESS_MODULE=wise_egomap.data.cli
export WISE_EGOMAP_FEATURES_MODULE=wise_egomap.evidence.cli
export WISE_EGOMAP_TRAIN_MODULE=wise_egomap.evidence.cli
export WISE_EGOMAP_EVAL_MODULE=wise_egomap.evaluation.cli
