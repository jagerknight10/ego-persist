# Source this file after you replace every placeholder.
# Keep the copied file outside Git. The project ignores .env.* files.

export EGOPERSIST_PROJECT_ROOT=/absolute/path/to/ego-persist
export EGOPERSIST_DATA_ROOT=/absolute/path/to/read-only/adt
export EGOPERSIST_RUN_ROOT=/absolute/path/to/writable/runs
export EGOPERSIST_IMAGE=/absolute/path/to/egopersist.sif
export EGOPERSIST_SLURM_PARTITION=<GPU_PARTITION>
export EGOPERSIST_SLURM_ACCOUNT=<ACCOUNT>

export EGOPERSIST_DATA_CONFIG="${EGOPERSIST_PROJECT_ROOT}/configs/data/adt_v1.yaml"
export EGOPERSIST_LABEL_CONFIG="${EGOPERSIST_PROJECT_ROOT}/configs/labels_v1.yaml"
export EGOPERSIST_EXPERIMENT_CONFIG="${EGOPERSIST_PROJECT_ROOT}/configs/experiment/evidence_gru.yaml"
export EGOPERSIST_MODEL_CONFIG="${EGOPERSIST_PROJECT_ROOT}/configs/model/evidence_gru.yaml"
export EGOPERSIST_SPLIT_FILE="${EGOPERSIST_DATA_ROOT}/splits/adt_splits_v1.json"
# One experiment = one run id. All stages share it. Train array tasks
# add the suffix _train_seed_<SEED> automatically.
export EGOPERSIST_RUN_ID=exp001
export EGOPERSIST_SEED_BASE=0

# Set after a train stage completes: the run id of the trained model to
# evaluate (for example exp001_train_seed_0). Leave unset to evaluate the
# Bayes baseline.
# export EGOPERSIST_MODEL_RUN_ID=exp001_train_seed_0

# Set to yes only after the ADT licence is approved.
export EGOPERSIST_ADT_LICENCE_APPROVED=no

# Optional stage entry points. Change only when a package owner moves the CLI.
export EGOPERSIST_PREPROCESS_MODULE=egopersist.data.cli
export EGOPERSIST_FEATURES_MODULE=egopersist.evidence.cli
export EGOPERSIST_TRAIN_MODULE=egopersist.evidence.cli
export EGOPERSIST_EVAL_MODULE=egopersist.evaluation.cli
